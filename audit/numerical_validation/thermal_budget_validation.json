{
  "fase": "Fase 3 - Fechamento Fisico do Orcamento Termico (A09, A10)",
  "A09_derivacao_e_unidades": {
    "equacao_1_conducao_fourier_quase_estatica": {
      "expressao": "T_rad,max = T_cap - (P_min,cores * R_r) / 4",
      "deducao": "Em equilíbrio quase-estático uniforme entre os 4 dies e o radiador, o fluxo condutivo total é Q_cond = sum_{i=1}^4 (T_i - T_rad)/R_r. Para que nenhum die exceda T_cap quando operado na potência mínima admissível P_min,cores = sum_{i=1}^4 P_i(F_MIN, T_i), exige-se 4*(T_cap - T_rad)/R_r >= P_min,cores, resultando em T_rad <= T_cap - (P_min,cores * R_r)/4.",
      "unidades": {
        "T_rad,max": "K",
        "T_cap": "K",
        "P_min,cores": "W",
        "R_r": "K/W"
      },
      "consistencia_dimensional": "K - (W * K/W) = K (Verificado)"
    },
    "equacao_2_constante_tempo_rc_radiador": {
      "expressao": "tau_rad = (C_rad * R_r) / 4",
      "valor_nominal_s": 682.08,
      "unidades": {
        "tau_rad": "s",
        "C_rad": "J/K",
        "R_r": "K/W"
      },
      "consistencia_dimensional": "(J/K) * (K/W) = J / (J/s) = s (Verificado)"
    },
    "equacao_3_buffer_entalpico_transiente": {
      "expressao": "P_buffer = (C_rad * max(0, T_rad,max - T_rad) / tau_horiz) * (1 - exp(-tau_horiz / tau_rad))",
      "deducao": "A reserva entálpica disponível no radiador até atingir T_rad,max é Delta_H = C_rad * (T_rad,max - T_rad) [J]. Distribuída sobre o horizonte preditivo tau_horiz = 240 s e ponderada pelo fator de relaxação RC de 1ª ordem (1 - exp(-tau_horiz/tau_rad)) da resposta ao degrau térmico entre os 4 dies e o radiador, obtém-se a taxa média segura de absorção transiente P_buffer [W].",
      "unidades": {
        "P_buffer": "W",
        "C_rad": "J/K",
        "Delta_T": "K",
        "tau_horiz": "s"
      },
      "consistencia_dimensional": "(J/K * K / s) * 1 = J/s = W (Verificado)"
    },
    "equacao_4_fechamento_orcamento": {
      "expressao": "P_budget = min(4 * max(0, T_cap - T_rad) / R_r, Q_rad,emit(T_rad) - q_m + P_buffer)",
      "tratamento_contingencia": "Se P_budget < P_min,cores, o estado é classificado explicitamente como 'physically_infeasible', incrementando n_deficit_orcamento e n_contingencia_inviavel e aplicando F_MIN sem mascarar o QP com piso artificial."
    }
  },
